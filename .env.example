# URL base del backend real (domna-api).
# - Vacía o sin definir  ⇒ el front usa el MOCK (datos de ejemplo, sin backend).
# - Con una URL          ⇒ el front usa la API real.
#
# Local (API corriendo con `dotnet run` en domna-api):
#   VITE_API_URL=http://localhost:5075
# Producción (ejemplo Railway):
#   VITE_API_URL=https://domna-api.up.railway.app
VITE_API_URL=
